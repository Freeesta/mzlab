{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-targets/1",
  "title": "quant-targets/1: every target of a table integrated in every file",
  "description": "The answer of `mzlab-cli quant targets --json`: the rows of the long table (the CSV of the command and of the Flow step `quant.targets@1`, one row per file and target, in input order, never hidden) and the log. Peaks are found by the peak auto-lr engine inside each target's RT window; every row has a state: detected (no flag among no_scans, no_peak, below_threshold, bad_shape), forced or absent. Code: crates/mzlab-feat/src/quant_targets/.",
  "type": "object",
  "required": [
    "schema",
    "rows",
    "log"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quant-targets/1"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "id",
          "area",
          "height",
          "sn",
          "rt",
          "flag",
          "state",
          "points",
          "shape",
          "start_rt",
          "end_rt",
          "peaks_in_window",
          "smooth_half",
          "mz_offset_da"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "File name as given (no folder)."
          },
          "id": {
            "type": "string",
            "description": "Target id of the table."
          },
          "area": {
            "type": [
              "number",
              "null"
            ],
            "description": "Area of the peak, counts x s (null: no peak)."
          },
          "height": {
            "type": [
              "number",
              "null"
            ],
            "description": "Apex height, counts."
          },
          "sn": {
            "type": [
              "number",
              "null"
            ],
            "description": "Signal-to-noise of the peak (peak auto-lr noise)."
          },
          "rt": {
            "type": [
              "number",
              "null"
            ],
            "description": "Apex RT, min."
          },
          "flag": {
            "type": "string",
            "pattern": "^(ok|(no_scans|no_peak|below_threshold|bad_shape|edge|in_blank)(;(below_threshold|bad_shape|edge|in_blank))*)$",
            "description": "ok, or the flags joined by ';': no_scans, no_peak, below_threshold, bad_shape, edge, in_blank."
          },
          "state": {
            "type": "string",
            "enum": [
              "detected",
              "forced",
              "absent"
            ],
            "description": "detected: a peak with S/N >= min_sn and an acceptable shape; forced: a peak under min_sn or the shape minimum, its numbers kept and flagged; absent: no peak in the window or no scan (numbers null). No value is gap-filled."
          },
          "points": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Scans between the edges of the peak."
          },
          "shape": {
            "type": [
              "number",
              "null"
            ],
            "description": "Correlation of the peak with a Gaussian of the same apex and width (peakq::quality)."
          },
          "start_rt": {
            "type": [
              "number",
              "null"
            ],
            "description": "Left edge, min."
          },
          "end_rt": {
            "type": [
              "number",
              "null"
            ],
            "description": "Right edge, min."
          },
          "peaks_in_window": {
            "type": "integer",
            "minimum": 0,
            "description": "Peaks with their apex inside the window; the row is the tallest."
          },
          "smooth_half": {
            "type": "integer",
            "minimum": 0,
            "description": "Savitzky-Golay half window the detection used on this trace."
          },
          "mz_offset_da": {
            "type": "number",
            "description": "m/z offset (observed - true) applied to this trace, Da."
          }
        }
      }
    },
    "log": {
      "type": "object",
      "description": "quant-targets-log/1: the log --log writes and the log port of the step.",
      "required": [
        "schema",
        "params",
        "files",
        "choices",
        "decisions",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "quant-targets-log/1"
        },
        "params": {
          "type": "object",
          "required": [
            "da",
            "min_sn",
            "min_points",
            "min_shape",
            "min_half",
            "max_fwhm",
            "max_asym",
            "offset",
            "blank_pattern",
            "ms_level",
            "smooth_half",
            "valley"
          ],
          "additionalProperties": false,
          "properties": {
            "da": {
              "type": "number"
            },
            "min_sn": {
              "type": "number"
            },
            "min_points": {
              "type": "integer"
            },
            "min_shape": {
              "type": "number"
            },
            "min_half": {
              "type": "integer",
              "description": "Fewest scans in an unbroken run at or over half the height; 0 = gate off."
            },
            "max_fwhm": {
              "type": "number",
              "description": "Widest peak at half height, seconds; 0 = gate off."
            },
            "max_asym": {
              "type": "number",
              "description": "Largest asymmetry at 10 % of the height (larger of right/left and left/right, 1 = symmetric); 0 = gate off."
            },
            "offset": {
              "type": "string"
            },
            "blank_pattern": {
              "type": "string"
            },
            "ms_level": {
              "type": "integer"
            },
            "smooth_half": {
              "type": "integer"
            },
            "valley": {
              "type": "number"
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "blank",
              "offsets",
              "detected",
              "forced",
              "detected_min"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "blank": {
                "type": "boolean"
              },
              "detected": {
                "type": "integer",
                "minimum": 0,
                "description": "Rows of this file without no_scans, no_peak, below_threshold, bad_shape."
              },
              "forced": {
                "type": "integer",
                "minimum": 0,
                "description": "Rows of this file with a peak that missed a check (state forced): their evidence is in decisions."
              },
              "offsets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "polarity",
                    "mz_offset_da",
                    "reference",
                    "evidence"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "polarity": {
                      "enum": [
                        "+",
                        "-",
                        "any"
                      ]
                    },
                    "mz_offset_da": {
                      "type": "number"
                    },
                    "reference": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The reference row measured (offset auto)."
                    },
                    "evidence": {
                      "type": "object",
                      "description": "The mzcal evidence of the offset (mode, ion, scans, apex, spread, S/N)."
                    }
                  }
                }
              },
              "detected_min": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The weakest detected peaks of this file: the smallest S/N and the fewest scans at or over half height among its detected rows, each with the id of its target, so the user sees how close the accepted peaks are to the thresholds. null when the file has no detected row.",
                "required": [
                  "sn",
                  "sn_id",
                  "half_pts",
                  "half_pts_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "sn": {
                    "type": "number"
                  },
                  "sn_id": {
                    "type": "string"
                  },
                  "half_pts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "half_pts_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "value",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "description": "The evidence of every row that is not detected: a peak that missed a check (state forced) lists every check with the value measured, its limit and whether it passed (limit null: a shape gate that is off, its value is shown only); a row with no peak (state absent) has the reason in flag (no_peak or no_scans) and no checks. A detected row is not listed: its numbers are in the table and the weakest ones of each file in files[].detected_min.",
          "items": {
            "type": "object",
            "required": [
              "file",
              "id",
              "state",
              "flag",
              "checks"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "forced",
                  "absent"
                ]
              },
              "flag": {
                "type": "string",
                "description": "The flags of the row joined with ';' (below_threshold, bad_shape, edge, in_blank; no_peak or no_scans for an absent row)."
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value",
                    "limit",
                    "op",
                    "pass"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "enum": [
                        "sn",
                        "points",
                        "shape",
                        "half_pts",
                        "fwhm_s",
                        "asym"
                      ]
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "null: the trace gave no number (an asymmetry on a peak that does not come down inside its limits); such a check passes."
                    },
                    "limit": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "null: a shape gate that is off (min_half, max_fwhm, max_asym = 0); the check is listed for its value and always passes."
                    },
                    "op": {
                      "enum": [
                        ">=",
                        "<="
                      ]
                    },
                    "pass": {
                      "type": "boolean"
                    }
                  }
                },
                "description": "Empty for an absent row."
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
