{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "msngrafo/1",
 "title": "msngrafo/1: the fragmentation graph of an MSn infusion",
 "description": "Format «msngrafo/1» (crates/mzlab-core/src/msngrafo/, docs/agenti/msn-grafo.md): one node per ion seen at any level, energy or path, one arc per precursor → fragment with the neutral loss. With the formula of the ion of the root given by the user (opzioni.formula) every fragment gets the sub-formulas of the root within its window (candidates, never a proposal) and the fragments with none leave the graph; without it the formulas are null. Same input, same bytes.",
 "type": "object",
 "required": [
  "formato",
  "motore",
  "sorgente",
  "opzioni",
  "polarita",
  "radici",
  "ione",
  "candidati_radice",
  "conteggi",
  "avvisi",
  "nodi",
  "archi",
  "spettri"
 ],
 "additionalProperties": false,
 "properties": {
  "formato": {
   "const": "msngrafo/1"
  },
  "motore": {
   "type": "string"
  },
  "sorgente": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "nome": {
     "type": "string"
    },
    "sha256_idx": {
     "type": "string"
    }
   }
  },
  "opzioni": {
   "type": "object",
   "required": [
    "ppm",
    "da_min",
    "min_rel",
    "max_picchi",
    "isotopi",
    "attivazione",
    "formula",
    "smiles",
    "ppm_formula",
    "mz_basso",
    "ppm_basso",
    "prove_min",
    "scelte"
   ],
   "properties": {
    "ppm": {
     "type": "number",
     "default": 5
    },
    "da_min": {
     "type": "number",
     "default": 0.002
    },
    "min_rel": {
     "type": "number",
     "default": 2
    },
    "max_picchi": {
     "type": "integer",
     "default": 120
    },
    "isotopi": {
     "type": "boolean",
     "default": false
    },
    "attivazione": {
     "type": [
      "string",
      "null"
     ]
    },
    "formula": {
     "type": [
      "string",
      "null"
     ],
     "description": "The ion of the root as typed (C8H11N4O2+, C8H10N4O2+H, C8H10N4O2 [M+H]+)"
    },
    "smiles": {
     "type": [
      "string",
      "null"
     ],
     "description": "The structure of the molecule, written back for the drawing of the fragments"
    },
    "ppm_formula": {
     "type": "number",
     "default": 10,
     "description": "Window of the sub-formulas, ppm"
    },
    "mz_basso": {
     "type": "number",
     "default": 150,
     "description": "Below this m/z the window may widen to ppm_basso"
    },
    "ppm_basso": {
     "type": "number",
     "default": 20
    },
    "prove_min": {
     "type": "integer",
     "minimum": 0,
     "default": 1,
     "description": "Evidences a candidate of the wide window needs"
    },
    "scelte": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "mz",
       "formula"
      ],
      "additionalProperties": false,
      "properties": {
       "mz": {
        "type": "number"
       },
       "formula": {
        "type": "string"
       }
      }
     },
     "description": "Formulas chosen by the user, found again on the node within its window"
    }
   }
  },
  "polarita": {
   "enum": [
    1,
    -1
   ]
  },
  "radici": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "ione": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "formula",
      "mz_teorico",
      "mz_osservato",
      "ppm"
     ],
     "additionalProperties": false,
     "properties": {
      "formula": {
       "type": "string"
      },
      "mz_teorico": {
       "type": "number"
      },
      "mz_osservato": {
       "type": "number"
      },
      "ppm": {
       "type": "number"
      }
     }
    }
   ]
  },
  "candidati_radice": {
   "description": "Without opzioni.formula: up to 8 formulas of the ion of the first root that fit its m/z (candidates, never an identification); empty otherwise.",
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": ["formula", "mz_teorico", "ppm"],
    "additionalProperties": false,
    "properties": {
     "formula": { "type": "string" },
     "mz_teorico": { "type": "number" },
     "ppm": { "type": "number" }
    }
   }
  },
  "conteggi": {
   "type": "object",
   "required": [
    "nodi",
    "archi",
    "scartati_pesanti",
    "scartati_isotopi",
    "scartati_deboli",
    "scartati_formula"
   ],
   "properties": {
    "nodi": {
     "type": "integer",
     "minimum": 0
    },
    "archi": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_pesanti": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_isotopi": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_deboli": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_formula": {
     "type": "integer",
     "minimum": 0,
     "description": "Nodes with no sub-formula of the root in their window (they are not in nodi)"
    }
   }
  },
  "avvisi": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "chiave",
     "albero",
     "nodo"
    ],
    "properties": {
     "chiave": {
      "enum": [
       "warn.msngrafo.isolation",
       "warn.msngrafo.precNotFound",
       "warn.msngrafo.polarity",
       "warn.msngrafo.badFormula",
       "warn.msngrafo.rootMissing",
       "warn.msngrafo.fixedNotFound",
       "warn.msngrafo.userConflict",
       "warn.msngrafo.isolatedUnexplained"
      ]
     },
     "albero": {
      "type": "string",
      "description": "Node of the tree; empty when the note is about the graph"
     },
     "nodo": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^n[0-9]+$"
     }
    }
   }
  },
  "nodi": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "mz",
     "dev_ppm",
     "livello",
     "isolato",
     "albero",
     "osservazioni",
     "rel_max",
     "isotopo_di",
     "m1",
     "isolamento",
     "non_spiegati",
     "pos",
     "formula"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^n[0-9]+$"
     },
     "mz": {
      "type": "number"
     },
     "dev_ppm": {
      "type": "number",
      "minimum": 0
     },
     "livello": {
      "type": "integer",
      "minimum": 1,
      "description": "MS level of the first spectrum in which the ion is seen; 1 = a root ion"
     },
     "isolato": {
      "type": "boolean"
     },
     "albero": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Nodes of the precursor tree whose precursor this ion is"
     },
     "osservazioni": {
      "type": "integer",
      "minimum": 0
     },
     "rel_max": {
      "type": "number"
     },
     "isotopo_di": {
      "type": [
       "string",
       "null"
      ]
     },
     "pos": {
      "type": "object",
      "required": [
       "col",
       "riga"
      ],
      "properties": {
       "col": {
        "type": "integer"
       },
       "riga": {
        "type": "integer"
       }
      }
     },
     "formula": {
      "description": "The sub-formulas of the ion of the root that explain the node: candidates, never an identification",
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "candidati",
         "scelta",
         "fonte"
        ],
        "properties": {
         "candidati": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "formula",
            "mz_teorico",
            "ppm",
            "dbe",
            "elettroni",
            "finestra",
            "prove"
           ],
           "properties": {
            "formula": {
             "type": "string"
            },
            "mz_teorico": {
             "type": "number"
            },
            "ppm": {
             "type": "number",
             "description": "(m/z of the node − mz_teorico) / mz_teorico"
            },
            "dbe": {
             "type": "number"
            },
            "elettroni": {
             "enum": [
              "pari",
              "dispari"
             ]
            },
            "finestra": {
             "type": "number",
             "description": "ppm_formula, or ppm_basso for a candidate with evidences"
            },
            "prove": {
             "type": "array",
             "items": {
              "enum": [
               "perdita",
               "isotopi",
               "msn"
              ]
             }
            }
           }
          },
          "description": "By |ppm|, then Hill order"
         },
         "scelta": {
          "type": [
           "string",
           "null"
          ],
          "description": "Only with one candidate, or chosen by the user"
         },
         "fonte": {
          "enum": [
           "radice",
           "unica",
           "utente",
           null
          ]
         }
        }
       }
      ]
     },
     "m1": {
      "type": [
       "number",
       "null"
      ],
      "description": "The M+1 of its most intense observation, % of it"
     },
     "isolamento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "larghezza",
       "a_monte",
       "stretto"
      ],
      "properties": {
       "larghezza": {
        "type": [
         "number",
         "null"
        ],
        "description": "Its own isolation window (Da), when it is isolated and the file says"
       },
       "a_monte": {
        "type": [
         "number",
         "null"
        ],
        "description": "The narrowest window on the path to the spectrum of its most intense observation (Da)"
       },
       "stretto": {
        "type": "boolean",
        "description": "a_monte < 2·1.00336 Da: its M+1 is not expected there, the isotopes are no evidence"
       }
      }
     },
     "non_spiegati": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "n",
         "picchi"
        ],
        "properties": {
         "n": {
          "type": "integer",
          "minimum": 1,
          "description": "Fragments of its spectra that left the graph (no sub-formula)"
         },
         "picchi": {
          "type": "array",
          "maxItems": 3,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "mz",
            "rel"
           ],
           "properties": {
            "mz": {
             "type": "number"
            },
            "rel": {
             "type": "number"
            }
           }
          }
         }
        }
       }
      ]
     }
    }
   }
  },
  "archi": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "da",
     "a",
     "perdita",
     "isolamento",
     "misure"
    ],
    "additionalProperties": false,
    "properties": {
     "da": {
      "type": "string"
     },
     "a": {
      "type": "string"
     },
     "perdita": {
      "type": "object",
      "required": [
       "da_massa",
       "formula",
       "ppm",
       "compatibile"
      ],
      "properties": {
       "da_massa": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "formula": {
        "type": [
         "string",
         "null"
        ],
        "description": "Chosen formula of the precursor minus that of the fragment (usual name for a known loss)"
       },
       "ppm": {
        "type": [
         "number",
         "null"
        ],
        "description": "Error of the loss in ppm of the m/z of the precursor"
       },
       "compatibile": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Known neutral losses within the tolerance, by mass only"
       }
      }
     },
     "isolamento": {
      "type": "boolean",
      "description": "The step belongs to an isolated path (the fragment is the precursor of a child of the spectrum)"
     },
     "misure": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "albero",
        "livello",
        "att",
        "ce",
        "n_scansioni",
        "rel"
       ],
       "additionalProperties": false,
       "properties": {
        "albero": {
         "type": "string",
         "description": "Node id of the precursor tree (msn_albero/1), the filter msn:<id>"
        },
        "livello": {
         "type": "integer",
         "minimum": 2
        },
        "att": {
         "type": "string",
         "description": "Activation of the last stage, lower case"
        },
        "ce": {
         "type": [
          "number",
          "null"
         ],
         "description": "Collision energy; null when the energies are merged"
        },
        "n_scansioni": {
         "type": "integer",
         "minimum": 1
        },
        "rel": {
         "type": "number",
         "minimum": 0,
         "description": "% of the base peak of the spectrum; 0 for an isolated precursor not found there"
        }
       }
      }
     }
    }
   }
  },
  "spettri": {
   "type": "array",
   "description": "Every spectrum of the tree in the graph, with its peaks: a peak with nodo null left the graph (unexplained); the clean spectrum is the others",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "albero",
     "livello",
     "att",
     "ce",
     "precursore",
     "larghezza",
     "picchi"
    ],
    "properties": {
     "albero": {
      "type": "string"
     },
     "livello": {
      "type": "integer",
      "minimum": 2
     },
     "att": {
      "type": "string"
     },
     "ce": {
      "type": [
       "number",
       "null"
      ]
     },
     "precursore": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^n[0-9]+$"
     },
     "larghezza": {
      "type": [
       "number",
       "null"
      ],
      "description": "Isolation window (Da)"
     },
     "picchi": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "mz",
        "rel",
        "nodo"
       ],
       "properties": {
        "mz": {
         "type": "number"
        },
        "rel": {
         "type": "number"
        },
        "nodo": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^n[0-9]+$"
        }
       }
      }
     }
    }
   }
  }
 }
}
