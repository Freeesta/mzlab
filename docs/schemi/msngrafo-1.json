{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "msngrafo/1",
 "title": "msngrafo/1: the fragmentation graph of an MSn infusion",
 "description": "Format «msngrafo/1» (crates/mzlab-core/src/msngrafo/, docs/agenti/msn-grafo.md): one node per ion seen at any level, energy or path, one arc per precursor → fragment with the neutral loss. With the formula of the ion of the root (opzioni.formula) every node below it gets a proposed sub-formula, with alternatives and reason; without it the formulas are null. Same input, same bytes.",
 "type": "object",
 "required": [
  "formato",
  "motore",
  "sorgente",
  "opzioni",
  "polarita",
  "radici",
  "ione",
  "calibrazione",
  "conteggi",
  "avvisi",
  "nodi",
  "archi"
 ],
 "additionalProperties": false,
 "properties": {
  "formato": {
   "const": "msngrafo/1"
  },
  "motore": {
   "type": "string"
  },
  "sorgente": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "nome": {
     "type": "string"
    },
    "sha256_idx": {
     "type": "string"
    }
   }
  },
  "opzioni": {
   "type": "object",
   "required": [
    "ppm",
    "da_min",
    "min_rel",
    "max_picchi",
    "isotopi",
    "attivazione",
    "formula",
    "calibra",
    "fissate"
   ],
   "properties": {
    "ppm": {
     "type": "number",
     "default": 5
    },
    "da_min": {
     "type": "number",
     "default": 0.002
    },
    "min_rel": {
     "type": "number",
     "default": 2
    },
    "max_picchi": {
     "type": "integer",
     "default": 120
    },
    "isotopi": {
     "type": "boolean",
     "default": false
    },
    "attivazione": {
     "type": [
      "string",
      "null"
     ]
    },
    "formula": {
     "type": [
      "string",
      "null"
     ],
     "description": "The ion of the root as typed (C8H11N4O2+, C8H10N4O2+H, C8H10N4O2 [M+H]+)"
    },
    "calibra": {
     "type": "boolean",
     "default": true
    },
    "fissate": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "mz",
       "formula"
      ],
      "additionalProperties": false,
      "properties": {
       "mz": {
        "type": "number"
       },
       "formula": {
        "type": "string"
       }
      }
     },
     "description": "Formulas chosen by the user, found again on the node within the tolerance"
    }
   }
  },
  "polarita": {
   "enum": [
    1,
    -1
   ]
  },
  "radici": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "ione": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "formula",
      "mz_teorico",
      "mz_osservato",
      "ppm"
     ],
     "additionalProperties": false,
     "properties": {
      "formula": {
       "type": "string"
      },
      "mz_teorico": {
       "type": "number"
      },
      "mz_osservato": {
       "type": "number"
      },
      "ppm": {
       "type": "number"
      }
     }
    }
   ]
  },
  "calibrazione": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "ppm",
      "n"
     ],
     "additionalProperties": false,
     "properties": {
      "ppm": {
       "type": "number",
       "description": "Median error removed from every m/z"
      },
      "n": {
       "type": "integer",
       "minimum": 3
      }
     }
    }
   ]
  },
  "conteggi": {
   "type": "object",
   "required": [
    "nodi",
    "archi",
    "scartati_pesanti",
    "scartati_isotopi",
    "scartati_deboli"
   ],
   "properties": {
    "nodi": {
     "type": "integer",
     "minimum": 0
    },
    "archi": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_pesanti": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_isotopi": {
     "type": "integer",
     "minimum": 0
    },
    "scartati_deboli": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "avvisi": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "chiave",
     "albero",
     "nodo"
    ],
    "properties": {
     "chiave": {
      "enum": [
       "warn.msngrafo.isolation",
       "warn.msngrafo.precNotFound",
       "warn.msngrafo.polarity",
       "warn.msngrafo.badFormula",
       "warn.msngrafo.rootMissing",
       "warn.msngrafo.fixedNotFound",
       "warn.msngrafo.userConflict",
       "warn.msngrafo.noFormula"
      ]
     },
     "albero": {
      "type": "string",
      "description": "Node of the tree; empty when the note is about the graph"
     },
     "nodo": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^n[0-9]+$"
     }
    }
   }
  },
  "nodi": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "mz",
     "dev_ppm",
     "livello",
     "isolato",
     "albero",
     "osservazioni",
     "rel_max",
     "isotopo_di",
     "pos",
     "formula"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^n[0-9]+$"
     },
     "mz": {
      "type": "number"
     },
     "dev_ppm": {
      "type": "number",
      "minimum": 0
     },
     "livello": {
      "type": "integer",
      "minimum": 1,
      "description": "MS level of the first spectrum in which the ion is seen; 1 = a root ion"
     },
     "isolato": {
      "type": "boolean"
     },
     "albero": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Nodes of the precursor tree whose precursor this ion is"
     },
     "osservazioni": {
      "type": "integer",
      "minimum": 0
     },
     "rel_max": {
      "type": "number"
     },
     "isotopo_di": {
      "type": [
       "string",
       "null"
      ]
     },
     "pos": {
      "type": "object",
      "required": [
       "col",
       "riga"
      ],
      "properties": {
       "col": {
        "type": "integer"
       },
       "riga": {
        "type": "integer"
       }
      }
     },
     "formula": {
      "description": "The proposed formula of the ion (a proposal, never an identification)",
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "proposta",
         "ppm",
         "dbe",
         "elettroni",
         "n_candidati",
         "alternative",
         "motivo",
         "fonte",
         "ambigua"
        ],
        "properties": {
         "proposta": {
          "type": "string"
         },
         "ppm": {
          "type": "number"
         },
         "dbe": {
          "type": "number"
         },
         "elettroni": {
          "enum": [
           "pari",
           "dispari"
          ]
         },
         "n_candidati": {
          "type": "integer",
          "minimum": 0,
          "description": "Sub-formulas of the root within the tolerance, before the constraints of the graph"
         },
         "alternative": {
          "type": "array",
          "maxItems": 4,
          "items": {
           "type": "object",
           "required": [
            "formula",
            "ppm",
            "dbe",
            "punteggio"
           ],
           "additionalProperties": false,
           "properties": {
            "formula": {
             "type": "string"
            },
            "ppm": {
             "type": "number"
            },
            "dbe": {
             "type": "number"
            },
            "punteggio": {
             "type": "number"
            }
           }
          }
         },
         "motivo": {
          "type": "object",
          "required": [
           "chiave",
           "parametri"
          ],
          "additionalProperties": false,
          "properties": {
           "chiave": {
            "enum": [
             "why.msngrafo.root",
             "why.msngrafo.user",
             "why.msngrafo.unique",
             "why.msngrafo.tree",
             "why.msngrafo.best"
            ]
           },
           "parametri": {
            "type": "object",
            "additionalProperties": {
             "type": "number"
            }
           }
          }
         },
         "fonte": {
          "enum": [
           "auto",
           "utente",
           "radice"
          ]
         },
         "ambigua": {
          "type": "boolean"
         }
        }
       }
      ]
     }
    }
   }
  },
  "archi": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "da",
     "a",
     "perdita",
     "isolamento",
     "misure"
    ],
    "additionalProperties": false,
    "properties": {
     "da": {
      "type": "string"
     },
     "a": {
      "type": "string"
     },
     "perdita": {
      "type": "object",
      "required": [
       "da_massa",
       "formula",
       "ppm",
       "compatibile"
      ],
      "properties": {
       "da_massa": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "formula": {
        "type": [
         "string",
         "null"
        ],
        "description": "Precursor formula minus fragment formula (usual name for a known loss)"
       },
       "ppm": {
        "type": [
         "number",
         "null"
        ],
        "description": "Error of the loss in ppm of the m/z of the precursor"
       },
       "compatibile": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Known neutral losses within the tolerance, by mass only"
       }
      }
     },
     "isolamento": {
      "type": "boolean",
      "description": "The step belongs to an isolated path (the fragment is the precursor of a child of the spectrum)"
     },
     "misure": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "albero",
        "livello",
        "att",
        "ce",
        "n_scansioni",
        "rel"
       ],
       "additionalProperties": false,
       "properties": {
        "albero": {
         "type": "string",
         "description": "Node id of the precursor tree (msn_albero/1), the filter msn:<id>"
        },
        "livello": {
         "type": "integer",
         "minimum": 2
        },
        "att": {
         "type": "string",
         "description": "Activation of the last stage, lower case"
        },
        "ce": {
         "type": [
          "number",
          "null"
         ],
         "description": "Collision energy; null when the energies are merged"
        },
        "n_scansioni": {
         "type": "integer",
         "minimum": 1
        },
        "rel": {
         "type": "number",
         "minimum": 0,
         "description": "% of the base peak of the spectrum; 0 for an isolated precursor not found there"
        }
       }
      }
     }
    }
   }
  }
 }
}
