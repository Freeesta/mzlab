{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tutorstat/1",
 "title": "tutorstat/1: the counters of the tutor for the teacher (level a)",
 "description": "Written by `mzlab_tutor::stat::Stat::to_json`. No question text, no student, no IP: only counts by day, block ids, intents and reasons. Costs are integer micro-dollars (1 USD = 1 000 000).",
 "type": "object",
 "required": ["schema", "course", "days"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "tutorstat/1"},
  "course": {"type": "string"},
  "days": {
   "type": "object",
   "description": "YYYY-MM-DD -> counters of that day",
   "additionalProperties": {
    "type": "object",
    "required": ["blocks", "cost_micros", "down_blocks", "intents", "passi", "questions", "tokens_in", "tokens_out", "uncovered", "votes_down", "votes_up"],
    "additionalProperties": false,
    "properties": {
     "questions": {"type": "integer", "minimum": 0},
     "passi": {"type": "integer", "minimum": 0, "description": "answers given in the passages mode (no model)"},
     "uncovered": {"type": "integer", "minimum": 0, "description": "questions no block matched: where the Teoria does not answer"},
     "intents": {"type": "object", "propertyNames": {"enum": ["concetto", "esercizio", "dati_lab", "fuori_tema", "iniezione"]}, "additionalProperties": {"type": "integer"}},
     "blocks": {"type": "object", "description": "block id -> times it was sent to the model or shown", "additionalProperties": {"type": "integer"}},
     "votes_up": {"type": "integer", "minimum": 0},
     "votes_down": {"type": "object", "propertyNames": {"enum": ["wrong", "unclear", "solved_exercise", "other"]}, "additionalProperties": {"type": "integer"}},
     "down_blocks": {"type": "object", "description": "block id -> negative votes on answers that cited it", "additionalProperties": {"type": "integer"}},
     "tokens_in": {"type": "integer", "minimum": 0},
     "tokens_out": {"type": "integer", "minimum": 0},
     "cost_micros": {"type": "integer", "minimum": 0}
    }
   }
  }
 }
}
