{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-conv-1",
  "title": "llm-conv/1: a conversation, neutral across vendors, the input of the adapters",
  "type": "object",
  "required": ["schema", "provider", "model", "messages"],
  "properties": {
    "schema": {"const": "llm-conv/1"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "system": {"type": "string"},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "parts"],
        "properties": {
          "role": {"enum": ["user", "assistant", "tool"]},
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "oneOf": [
                {"required": ["text"], "properties": {"text": {"type": "string"}}},
                {"required": ["context"], "properties": {"context": {"type": "object"}}},
                {"required": ["image"], "properties": {"image": {"type": "object", "required": ["png_b64"], "properties": {"png_b64": {"type": "string"}, "consent": {"type": "string"}}}}},
                {"required": ["tool_call"], "properties": {"tool_call": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "args": {"type": "object"}}}}},
                {"required": ["tool_result"], "properties": {"tool_result": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "ok": {"type": "boolean"}, "content": {}}}}}
              ]
            }
          }
        }
      }
    }
  }
}
