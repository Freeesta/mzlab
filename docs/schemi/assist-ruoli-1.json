{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "assist-ruoli/1",
 "title": "assist-ruoli/1: the subagents of the data assistant",
 "description": "Format «assist-ruoli/1» (crates/mzlab-llm/data/assist/assist-ruoli-1.json, docs/agenti/llm.md): for each subagent its prompt file, model, effort, output limit, the schema of its output and the sources it is given. No model or effort is written in the code; the prompt files are exact copies of the ```text blocks of docs/studi/assistente-dati/prompt/0N_*.md.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "roles", "orchestrator"],
 "properties": {
  "schema": {"const": "assist-ruoli/1"},
  "roles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["role", "prompt", "model", "effort", "max_tokens", "output_schema", "input_sources"],
    "properties": {
     "role": {"enum": ["router", "metadati", "cromatografia", "parametri", "interprete", "grafici"]},
     "prompt": {"type": "string", "pattern": "^0[0-9]_[a-z]+\\.md$"},
     "model": {"type": "string", "pattern": "^claude-"},
     "effort": {"enum": ["low", "medium", "high"]},
     "max_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
     "output_schema": {"enum": ["router/1", "lettura/1", "param-scelte/1", "grafico/1"]},
     "input_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
   }
  },
  "orchestrator": {
   "type": "object",
   "additionalProperties": false,
   "required": ["prompt", "phase_prompt", "model", "effort", "max_tokens", "max_tokens_plan"],
   "properties": {
    "prompt": {"type": "string"},
    "phase_prompt": {"type": "string"},
    "model": {"type": "string", "pattern": "^claude-"},
    "effort": {"enum": ["low", "medium", "high"]},
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
    "max_tokens_plan": {"type": "integer", "minimum": 1, "maximum": 8192}
   }
  }
 }
}
