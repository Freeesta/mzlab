                      "type": "integer"
                    },
                    "ion_quantum": {
                      "type": "object"
                    },
                    "counts": {
                      "type": "boolean",
                      "description": "true when the ion quantum is accepted, so counts, sigma and verdicts are given"
                    },
                    "mz_offset": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "thresholds": {
                      "type": "object",
                      "required": [
                        "min_counts",
                        "z_ok",
                        "z_bad",
                        "c13_pct",
                        "carbon_k",
                        "m2_ratio",
                        "m2_k",
                        "min_r",
                        "min_sn",
                        "min_points",
                        "alpha",
                        "side_min",
                        "gap_min"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "file",
              "error"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "error": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
