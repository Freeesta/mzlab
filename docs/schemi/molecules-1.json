{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "molecules/1",
 "title": "molecules/1: the molecules database (catalogue, imported and user records)",
 "description": "Written by mzlab-core `molecules`. Canonical JSON: keys in alphabetical order, records sorted by id, lists tidy; its SHA-256 enters prov/1. The mass is computed from formula and charge (electron included), never read.",
 "type": "object",
 "required": ["molecules", "schema"],
 "properties": {
  "schema": {"const": "molecules/1"},
  "molecules": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["adducts", "charge", "classes", "collections", "external", "formula", "id", "inchikey", "mass", "name", "notes", "origin", "properties", "smiles", "synonyms"],
    "properties": {
     "id": {"type": "string", "pattern": "^(ik:[A-Z]{14}-[A-Z]{10}-[A-Z]|u:[0-9a-f]{12})$", "description": "ik:<InChIKey> when there is one, else u:<first 12 hex of the SHA-256 of the record at birth>; never changes"},
     "name": {"type": "string", "minLength": 1},
     "synonyms": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "sorted, no repeats (case ignored), without name"},
     "formula": {"type": "string", "description": "Hill order, no charge sign"},
     "charge": {"type": "integer", "description": "0 for a neutral molecule"},
     "mass": {"type": "number", "description": "monoisotopic mass of the species in Da, 6 decimals, computed"},
     "smiles": {"type": ["string", "null"]},
     "inchikey": {"type": ["string", "null"], "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"},
     "adducts": {"type": "array", "items": {"type": "string"}, "description": "preferred adducts by name, in order of preference"},
     "collections": {"type": "array", "items": {"type": "string"}, "description": "groups of the user (sorted)"},
     "classes": {"type": "array", "items": {"type": "string", "pattern": "^[^:]+:.+$"}, "description": "key:value labels (sorted)"},
     "external": {"type": "object", "properties": {"cas": {"type": "string"}, "pubchem_cid": {"type": "string"}}, "additionalProperties": false},
     "properties": {
      "type": "array",
      "description": "sorted by key; one value per key",
      "items": {
       "type": "object",
       "required": ["conditions", "key", "source", "unit", "value"],
       "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "description": "1 for a dimensionless value"},
        "source": {"type": "string", "minLength": 1},
        "conditions": {"type": "string"}
       }
      }
     },
     "notes": {"type": "string"},
     "origin": {
      "type": "object",
      "required": ["catalog", "created", "file", "modified", "type"],
      "properties": {
       "type": {"enum": ["catalog", "imported", "user"]},
       "catalog": {"type": "array", "items": {"enum": ["tabui", "hrms"]}},
       "file": {"type": ["string", "null"]},
       "created": {"type": ["string", "null"], "description": "ISO date"},
       "modified": {"type": ["string", "null"], "description": "ISO date"}
      }
     }
    }
   }
  }
 }
}
