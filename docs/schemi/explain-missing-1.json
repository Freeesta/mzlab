{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explain-missing/1",
  "title": "explain-missing/1: the answer of `mzlab-cli explain-missing --json`",
  "description": "The CSV report as one document: `columns` and `rows` of cells as text (empty cells empty). Code: crates/mzlab-cli/src/flow_explain.rs.",
  "type": "object",
  "required": [
    "schema",
    "columns",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "explain-missing/1"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
