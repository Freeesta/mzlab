{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commands/1",
  "title": "commands/1: every command of mzlab-cli, its arguments, flags and outputs",
  "description": "The answer of `mzlab-cli commands --json [PATH...]`, built from the same table as `--help`: `synopsis` is the usage line, `args` and `flags` are read from it, so help and catalog cannot differ. `stdout.schema` names a schema that `mzlab-cli schema NAME` prints (empty when the command prints none, or several). The whole listing (`compact`: true) says what is shared or derivable once at the top (`flag_help`, `exit_codes_note`, `examples_note`) and leaves it out of each command; `commands --json PATH...` gives each command in full. `exit_codes` lists the codes of the command, `exit_code_meaning` (top level) says what each means. Code: crates/mzlab-cli/src/catalog.rs. A flag object leaves out `unit`, `default` and `enum` when they are null, and `repeat` and `required` when false.",
  "type": "object",
  "required": [
    "schema",
    "citation",
    "exit_code_meaning",
    "global_flags",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "commands/1"
    },
    "citation": {
      "type": "string"
    },
    "exit_code_meaning": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "global_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "help"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^--"
          },
          "type": {
            "enum": [
              "bool",
              "int",
              "number",
              "string",
              "path",
              "list",
              "enum",
              "set"
            ]
          },
          "unit": {
            "type": "string"
          },
          "default": {},
          "enum": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "help": {
            "type": "string"
          },
          "repeat": {
            "type": "boolean"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "synopsis",
          "summary",
          "args",
          "flags",
          "stdout"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "synopsis": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "path",
                    "value",
                    "rest"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "repeat": {
                  "type": "boolean"
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^--"
                },
                "type": {
                  "enum": [
                    "bool",
                    "int",
                    "number",
                    "string",
                    "path",
                    "list",
                    "enum",
                    "set"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "default": {},
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "help": {
                  "type": "string"
                },
                "repeat": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "stdin": {
            "type": "boolean"
          },
          "stdout": {
            "type": "object",
            "required": [
              "format"
            ],
            "properties": {
              "format": {
                "enum": [
                  "json",
                  "csv",
                  "text"
                ]
              },
              "schema": {
                "type": "string"
              },
              "json_flag": {
                "type": "boolean"
              }
            }
          },
          "exit_codes": {
            "type": "array",
            "items": {
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                6,
                7
              ]
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "compact": {
      "const": true
    },
    "detail": {
      "type": "string"
    },
    "flag_help_note": {
      "type": "string"
    },
    "exit_codes_note": {
      "type": "string"
    },
    "examples_note": {
      "type": "string"
    },
    "flag_help": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "the help of every flag used by two or more commands; a flag object with no help takes it from here"
    }
  }
}
