{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "insilico/1",
 "title": "insilico/1: catalogue of the in-silico candidate package",
 "description": "Format «insilico/1» (crates/mzlab-cli/src/insilico_pack.rs, docs/agenti/insilico.md), written by `mzlab-cli insilico pack` next to the pieces NNN.bin. The pieces are zlib CSV (columns Identifier, CompoundName, SMILES, MolecularFormula, MonoisotopicMass) sorted by mass; spectra.insilico@1 reads only the pieces whose mass range overlaps the db_ppm window of a precursor. Same input, same bytes.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "compression",
  "piece_raw",
  "columns",
  "rows",
  "skipped_rows",
  "size",
  "size_compressed",
  "sha256",
  "mass_min",
  "mass_max",
  "source",
  "licence",
  "attribution",
  "pieces"
 ],
 "properties": {
  "format": {
   "const": "insilico/1"
  },
  "compression": {
   "const": "zlib"
  },
  "piece_raw": {
   "type": "integer",
   "minimum": 1,
   "description": "Raw bytes at which a piece is cut."
  },
  "columns": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rows": {
   "type": "integer",
   "minimum": 1,
   "description": "Candidates in the pieces."
  },
  "skipped_rows": {
   "type": "integer",
   "minimum": 0,
   "description": "Rows of the source left out (no SMILES, or no mass)."
  },
  "size": {
   "type": "integer",
   "description": "Total inflated bytes."
  },
  "size_compressed": {
   "type": "integer",
   "description": "Total compressed bytes (what a download costs)."
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "SHA-256 of the inflated pieces joined in order."
  },
  "mass_min": {
   "type": "number"
  },
  "mass_max": {
   "type": "number"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "version",
    "doi",
    "sha256"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "doi": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "description": "SHA-256 of the source CSV."
    }
   }
  },
  "licence": {
   "const": "CC-BY-4.0"
  },
  "attribution": {
   "type": "string"
  },
  "pieces": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "file",
     "mass_min",
     "mass_max",
     "rows",
     "size",
     "sha256",
     "size_raw",
     "sha256_raw"
    ],
    "properties": {
     "file": {
      "type": "string",
      "pattern": "^[0-9]{3}\\.bin$",
      "description": "The zlib file of the piece, next to the catalogue."
     },
     "mass_min": {
      "type": "number",
      "description": "Lowest MonoisotopicMass of the rows (Da)."
     },
     "mass_max": {
      "type": "number",
      "description": "Highest MonoisotopicMass of the rows (Da)."
     },
     "rows": {
      "type": "integer",
      "minimum": 1
     },
     "size": {
      "type": "integer",
      "minimum": 1,
      "description": "Bytes of the compressed file."
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the compressed file."
     },
     "size_raw": {
      "type": "integer",
      "minimum": 1,
      "description": "Bytes of the inflated CSV."
     },
     "sha256_raw": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the inflated CSV."
     }
    }
   }
  }
 }
}
