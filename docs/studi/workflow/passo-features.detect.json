{
 "schema": "passo/1",
 "id": "features.detect",
 "family": "features.detect",
 "version": 1,
 "title": "Detect features",
 "doc": "Builds the mass traces of the MS1 scans of each file and cuts them into chromatographic peaks. Defaults and fields are the ones of trace::Params in crates/mzlab-feat/src/trace.rs.",
 "cv": "MS:1000035",
 "in": {
  "index": {
   "type": "mzidx",
   "many": true,
   "title": "Scan index",
   "requires": {
    "ms_levels": [
     1
    ]
   }
  }
 },
 "out": {
  "peaks": {
   "type": "peaks",
   "many": true,
   "title": "Features of each file"
  }
 },
 "params": {
  "type": "object",
  "properties": {
   "polarity": {
    "title": "Polarity",
    "enum": [
     1,
     -1,
     0
    ],
    "default": 1,
    "description": "1 positive, -1 negative, 0 all MS1 scans"
   },
   "floor": {
    "title": "Noise floor",
    "type": "number",
    "minimum": 0,
    "default": 20000,
    "x-unit": "counts",
    "x-estimate": true,
    "description": "Points below are ignored; left empty, it is estimated from the intensity histogram"
   },
   "min_height": {
    "title": "Minimum height",
    "type": "number",
    "minimum": 0,
    "default": 200000,
    "x-unit": "counts"
   },
   "min_points": {
    "title": "Minimum points",
    "type": "integer",
    "minimum": 2,
    "default": 5,
    "x-advanced": true
   },
   "max_gap": {
    "title": "Maximum gap",
    "type": "integer",
    "minimum": 0,
    "default": 2,
    "x-unit": "scans",
    "x-advanced": true
   },
   "long_trace": {
    "title": "Long trace",
    "type": "integer",
    "minimum": 1,
    "default": 400,
    "x-unit": "scans",
    "x-advanced": true
   },
   "axis": {
    "title": "m/z axis",
    "enum": [
     "ppm",
     "Da"
    ],
    "default": "ppm",
    "x-advanced": true
   },
   "budget": {
    "title": "Working memory",
    "type": "integer",
    "x-unit": "bytes",
    "x-noresult": true,
    "x-advanced": true
   }
  }
 },
 "runs_in": {
  "wasm": "feat (detect)",
  "wasm_ceiling_bytes": 512000,
  "native": true
 },
 "deterministic": true,
 "errors": [
  "error.memoryBudget",
  "err.file.index"
 ],
 "per_item": true,
 "presets": {
  "hr": {
   "title": "High resolution",
   "when": {
    "resolution": [
     "hr"
    ]
   },
   "params": {
    "axis": "ppm",
    "floor": 20000,
    "min_height": 200000
   },
   "evidence": "defaults of trace::Params"
  },
  "lr": {
   "title": "Unit resolution",
   "when": {
    "resolution": [
     "lr"
    ]
   },
   "params": {
    "axis": "Da",
    "floor": 2000,
    "min_height": 20000
   },
   "evidence": "LR_FLOOR and LR_MIN_HEIGHT of recipe_lr.rs; the preview proposes the values of each file"
  }
 },
 "default_preset": "hr",
 "memory_hint_bytes": 6430000
}
