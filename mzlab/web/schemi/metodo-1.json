              "B_pct": {
                "type": "number"
              },
              "flusso_mL_min": {
                "type": "number"
              }
            },
            "required": [
              "t_min"
            ]
          }
        },
        "flusso_mL_min": {
          "type": "number"
        },
        "B_iniziale_pct": {
          "type": "number"
        },
        "forno_C": {
          "type": "number"
        },
        "durata_min": {
          "type": "number"
        },
