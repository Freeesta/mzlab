                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "ce_eV": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "parametri": {
                      "$ref": "#/$defs/parametri"
                    },
                    "transizioni": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "q1": {
                            "type": "number"
                          },
                          "q3": {
                            "type": "number"
                          },
                          "dwell_ms": {
                            "type": "number"
                          },
                          "ce_eV": {
                            "type": "number"
                          },
                          "nome": {
                            "type": "string"
                          },
                          "rf_lens_V": {
                            "type": "number"
                          },
                          "polarita": {
                            "type": "string",
                            "enum": [
                              "positive",
                              "negative"
                            ]
                          },
                          "t_inizio_min": {
                            "type": "number"
                          },
                          "t_fine_min": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "calibrazione": {
          "type": "object",
          "properties": {
            "lock_mass": {
              "type": "object",
              "properties": {
                "modo": {
                  "type": "string"
                },
                "elenchi": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "polarita": {
                        "type": "string",
                        "enum": [
                          "positive",
                          "negative"
                        ]
                      },
                      "nome": {
                        "type": "string"
                      },
                      "masse_mz": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                "numero_nel_trailer": {
                  "type": "number"
                },
                "correzione_ppm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      }
    },
    "lc": {
      "type": "object",
      "properties": {
        "gradiente": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t_min": {
                "type": "number"
