{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metodo/1",
  "description": "Metodo di acquisizione di UN campione (o, per una cartella di metodo `.m` senza corsa, il metodo di analisi dei dati). Un valore sconosciuto è ASSENTE (mai null, mai 0); le sezioni vuote sono omesse; le unità stanno nel nome del campo.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "metodo/1"
    },
    "origine": {
      "type": "object",
      "properties": {
        "formato": {
          "type": "string"
        },
        "file": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nome": {
                "type": "string"
              },
              "sha1": {
                "type": "string"
              },
              "byte": {
                "type": "number"
              }
            }
          }
        },
        "campione": {
          "type": "number"
        },
        "file_creato": {
          "type": "string"
        },
        "lettore": {
          "type": "object",
          "properties": {
            "nome": {
              "type": "string"
            },
            "versione": {
              "type": "string"
            }
          }
        }
      }
    },
    "campione": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "vial": {
          "type": "string"
        },
        "iniezione_uL": {
          "type": "number"
        },
        "metodo_file": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "commento": {
          "type": "string"
        },
        "diluizione": {
          "type": "number"
        },
        "peso": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "istd": {
          "type": "number"
        }
      }
    },
    "strumento": {
      "type": "object",
      "properties": {
        "produttore": {
          "type": "string"
        },
        "modello": {
          "type": "string"
        },
        "serie": {
          "type": "string"
        },
        "software": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nome": {
                "type": "string"
              },
              "versione": {
                "type": "string"
              }
            }
          }
        },
        "computer": {
          "type": "string"
