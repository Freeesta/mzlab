          },
          "nm": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "passo_nm": {
            "type": "number"
          },
          "frequenza_Hz": {
            "type": "number"
          },
          "lampada": {
            "type": "string"
          },
          "cella_C": {
            "type": "number"
          },
          "fenditura_nm": {
            "type": "number"
          },
          "canali": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nm": {
                  "type": "number"
                },
                "banda_nm": {
                  "type": "number"
