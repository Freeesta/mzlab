          "type": "string"
        },
        "computer": {
          "type": "string"
        }
      }
    },
    "ms": {
      "type": "object",
      "properties": {
        "sorgente": {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string"
            },
            "parametri": {
              "$ref": "#/$defs/parametri"
            }
          }
        },
        "periodi": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "esperimenti": {
                "type": "array",
