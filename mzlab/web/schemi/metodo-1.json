                "riferimento_nm": {
                  "type": "number"
                },
                "banda_riferimento_nm": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "registro": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quando": {
            "enum": [
              "inizio",
              "fine"
            ]
          },
          "testo": {
            "type": "string"
          },
          "t_min": {
            "type": "number"
          },
          "livello": {
            "enum": [
              "Info",
              "Warning",
              "Error"
            ]
          }
        }
      }
    },
    "serie_registro": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "gruppo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "unita": {
            "type": "string"
          },
          "n": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      }
    },
    "quantificazione": {
      "type": "object",
      "properties": {
        "versione_dati": {
          "type": "number"
