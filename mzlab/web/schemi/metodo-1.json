            "riferimento": {
              "type": "number"
            },
            "non_riferimento": {
              "type": "number"
            },
            "unita": {
              "type": "string"
            },
            "correlazione": {
              "type": "number"
            }
          }
        },
        "composti": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "nome": {
                "type": "string"
              },
              "tipo": {
                "type": "string"
              },
              "istd": {
                "type": "boolean"
              },
              "rt_min": {
                "type": "number"
              },
              "finestra_rt": {
                "type": "object",
                "properties": {
                  "valore": {
                    "type": "number"
                  },
                  "unita": {
                    "type": "string"
                  }
                }
              },
              "segmento_tempo": {
                "type": "number"
              },
              "polarita": {
                "type": "string"
              },
              "tipo_scansione": {
                "type": "string"
              },
              "mz": {
                "type": "number"
              },
              "finestra_mz": {
                "type": "object",
                "properties": {
                  "sinistra": {
                    "type": "number"
                  },
                  "destra": {
                    "type": "number"
                  },
                  "unita": {
                    "type": "string"
                  }
                }
              },
              "integratore": {
                "type": "string"
              },
              "curva": {
                "type": "object",
                "properties": {
                  "modello": {
                    "type": "string"
                  },
                  "origine": {
                    "type": "string"
                  },
                  "peso": {
                    "type": "string"
                  }
                }
              },
              "unita_conc": {
                "type": "string"
              },
              "ioni": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "indice": {
                      "type": "number"
                    },
                    "mz": {
                      "type": "number"
                    },
                    "risposta_relativa_pct": {
                      "type": "number"
                    },
                    "min_pct": {
                      "type": "number"
                    },
                    "max_pct": {
                      "type": "number"
                    },
                    "incertezza_pct": {
                      "type": "number"
                    }
                  }
                }
              },
              "livelli": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nome": {
                      "type": "string"
                    },
                    "conc": {
                      "type": "number"
                    },
                    "attivo": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Metodo di quantificazione (cartella .m di Agilent): ciò che il metodo cerca, per composto. Un m/z di 0 nel file è «non impostato»: assente."
    },
    "grezzo": {
      "type": "array",
      "description": "Testo del registro dello strumento così com'è (al massimo 256 KB).",
      "items": {
        "type": "object",
        "properties": {
          "sezione": {
            "type": "string"
          },
          "testo": {
            "type": "string"
          }
        }
      }
    },
    "avvisi": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chiave": {
            "type": "string"
          },
          "dove": {
            "type": "string"
          }
        }
      }
    },
    "campi": {
      "type": "array",
      "description": "Ogni campo del file che le sezioni non portano, con il posto da cui viene (nessuna perdita). Ordinati per (origine, chiave).",
      "items": {
        "type": "object",
        "properties": {
          "origine": {
            "type": "string",
            "description": "<formato>:<flusso o file>[#chiave]"
          },
          "chiave": {
            "type": "string"
          },
          "valore": {
            "type": "string"
          },
          "unita": {
            "type": "string"
          },
          "mappato": {
            "type": "string",
            "description": "Dove il valore è anche nel documento (es. campione.vial)."
          },
          "identita": {
            "type": "boolean",
            "description": "true: identifica una persona, un computer, un seriale o un percorso."
          }
        },
        "required": [
          "origine",
          "chiave",
          "valore"
        ]
      }
