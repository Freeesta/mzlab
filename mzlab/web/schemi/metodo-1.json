  },
  "$defs": {
    "parametri": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "etichetta": {
            "type": "string"
          },
          "valore": {
            "type": "number"
          },
          "unita": {
            "type": "string"
          }
        }
      }
    }
  }
}
