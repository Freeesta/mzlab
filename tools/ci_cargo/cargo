#!/usr/bin/env python3
"""`cargo` of the CI pytest jobs (first in PATH, see test.yml): `cargo run ...` becomes `cargo build ...` plus the exec of the binary that was built.
The real `cargo run` holds the lock of the build directory until the program ends, so every other worker that calls cargo waits for it; here the lock is
released as soon as the build is done. Any other command, or a target this script cannot find, goes to the real cargo untouched.
Builds also get a target directory per feature family (target/fam/<name>): the same crate built with other features in a shared directory is compiled again
at every alternation and the builds queue on one lock. The built files are hard-linked back to target/ so the paths written in the tests keep working."""
import json
import os
import shutil
import subprocess
import sys

AQUI = os.path.dirname(os.path.abspath(__file__))
PATH = os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep) if os.path.abspath(p or ".") != AQUI)
REALE = shutil.which("cargo", path=PATH)
ENV = {**os.environ, "PATH": PATH}


def reale(args):
    os.execve(REALE, [REALE, *args], ENV)


def valore(args, nome):
    for i, a in enumerate(args):
        if a == nome and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(nome + "="):
            return a.split("=", 1)[1]
    return None


def famiglia(args):
    """Name of the feature family of a build/run command, or None to leave it in target/."""
    if args[0] not in ("build", "run", "check", "test") or any(a.startswith("--target-dir") for a in args):
        return None
    triple = valore(args, "--target")
    if triple:
        return "wasm"
    pacchetti = [args[i + 1] for i, a in enumerate(args[:-1]) if a in ("-p", "--package")]
    if "mzlab-cli" in pacchetti:
        return "cli"
    funzioni = valore(args, "--features")
    if funzioni:
        return "feat-" + "".join(c if c.isalnum() else "_" for c in funzioni)
    if any(p in ("mzlab-feat-wasm", "mzlab-feat-table-wasm", "mzlab-feat") for p in pacchetti):
        return "feat"
    return None


def rispecchia(radice, fam_dir):
    """Hard-link the binaries, examples and .wasm of a family directory to the same paths under target/."""
    for rel in ("release", "release/examples", "wasm32-unknown-unknown/release", "wasm32-wasip1/release/examples", "wasm32-wasip1/release"):
        da, a = os.path.join(fam_dir, rel), os.path.join(radice, rel)
        if not os.path.isdir(da):
            continue
        os.makedirs(a, exist_ok=True)
        for nome in os.listdir(da):
            sorgente = os.path.join(da, nome)
            if os.path.isfile(sorgente) and not nome.endswith(".d"):
                destino = os.path.join(a, nome)
                # a name per process: workers mirror the same files at the same time
                tmp = f"{destino}.{os.getpid()}.tmp"
                try:
                    if os.path.exists(destino) and os.path.samefile(sorgente, destino):
                        continue
                    try:
                        os.link(sorgente, tmp)
                    except OSError:
                        shutil.copy2(sorgente, tmp)
                    os.replace(tmp, destino)
                except OSError:
                    # a file rebuilt by another worker meanwhile: its own mirror run takes it
                    continue


def main():
    global ENV
    args = sys.argv[1:]
    fam = famiglia(args) if args and not os.environ.get("CARGO_TARGET_DIR") else None
    if fam:
        radice = os.path.join(os.getcwd(), "target")
        fam_dir = os.path.join(radice, "fam", fam)
        ENV = {**ENV, "CARGO_TARGET_DIR": fam_dir}
        if args[0] != "run":
            r = subprocess.run([REALE, *args], env=ENV)
            if r.returncode == 0:
                rispecchia(radice, fam_dir)
            sys.exit(r.returncode)
    if not args or args[0] != "run":
        reale(args)
    resto = []
    if "--" in args:
        i = args.index("--")
        args, resto = args[:i], args[i + 1:]
    esempio, binario = valore(args, "--example"), valore(args, "--bin")
    pacchetto = valore(args, "-p") or valore(args, "--package")
    b = subprocess.run([REALE, "build", *args[1:], "--message-format=json-render-diagnostics"], env=ENV, stdout=subprocess.PIPE, text=True)
    if b.returncode:
        sys.exit(b.returncode)
    eseguibili = []
    for riga in b.stdout.splitlines():
        try:
            m = json.loads(riga)
        except ValueError:
            continue
        kind = m.get("target", {}).get("kind", [])
        if m.get("reason") == "compiler-artifact" and m.get("executable") and ("example" in kind or "bin" in kind):
            eseguibili.append((m["target"]["name"], "example" in kind, m["package_id"], m["executable"]))
    if esempio:
        scelti = [e for e in eseguibili if e[0] == esempio and e[1]]
    elif binario:
        scelti = [e for e in eseguibili if e[0] == binario and not e[1]]
    else:
        scelti = [e for e in eseguibili if not e[1] and (pacchetto is None or pacchetto in e[2])]
    if len(scelti) != 1:
        reale(sys.argv[1:])
    os.execve(scelti[0][3], [scelti[0][3], *resto], ENV)


if __name__ == "__main__":
    main()
