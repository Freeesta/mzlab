[
  {
    "expect": [],
    "name": "a comparison of two algorithms with tolerances is valid",
    "plan": {
      "format": "mzflow/2",
      "inputs": [
        {
          "name": "q.mgf",
          "type": "spectra"
        },
        {
          "name": "lib.msp",
          "type": "library"
        }
      ],
      "steps": [
        {
          "id": "cmp",
          "in": {
            "library": "file:lib.msp",
            "query": "file:q.mgf"
          },
          "params": {
            "mz_tolerance_ppm": 5,
            "rt_tolerance_min": 0.2,
            "step": "spectra.match@1",
            "variants": [
              {
                "algorithm": "spectral_entropy"
              },
              {
                "algorithm": "modified_cosine",
                "label": "mod"
              }
            ]
          },
          "step": "meta.compare@1"
        }
      ]
    }
  },
  {
    "expect": [
      "lv|candidates|err.flow.ref.unknown|ref=cmp.comparison"
    ],
