          "params": {
            "polarity": 1
          },
          "preset": "hr",
          "step": "features.detect@1"
        },
        {
          "id": "al",
          "in": {
            "peaks": [
              "de.peaks"
            ]
          },
          "step": "features.align@1"
        }
      ]
    }
  },
