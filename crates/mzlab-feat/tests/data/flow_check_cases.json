[
  {
    "expect": [],
    "name": "a valid chain from a vendor file to the aligned table",
    "plan": {
      "format": "mzflow/2",
      "inputs": [
        {
          "name": "a.raw",
          "sha256": "",
          "type": "raw"
        }
      ],
      "program": {
        "name": "mzLab",
        "version": "1"
      },
      "steps": [
        {
          "id": "cv",
          "in": {
            "raw": "file:a.raw"
          },
          "step": "convert.mzml@1"
        },
        {
          "id": "ix",
          "in": {
            "source": "cv.mzml"
          },
          "step": "index.mzidx@1"
        },
        {
          "algorithm": "masstrace",
          "id": "de",
          "in": {
            "index": [
